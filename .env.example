# Copy to .env and change the password. Never commit .env (it is in .gitignore).
POSTGRES_USER=recytrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recytrack

# Used when running the API outside Docker against a local PostgreSQL.
# Leave unset to use a local SQLite file (backend/recytrack.db) instead.
# DATABASE_URL=postgresql+psycopg://recytrack:change-me@localhost:5432/recytrack
