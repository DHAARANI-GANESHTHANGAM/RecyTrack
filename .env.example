# Copy to .env and change the password. Never commit .env (it is in .gitignore).
POSTGRES_USER=recytrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recytrack

# Used when running the API outside Docker against a local PostgreSQL.
# Leave unset to use a local SQLite file (backend/recytrack.db) instead.
# DATABASE_URL=postgresql+psycopg://recytrack:change-me@localhost:5432/recytrack

# Simulated API source (M7). Docker Compose sets SIMULATED_SOURCE_URL to http://simulator:8001.
# SIMULATED_SOURCE_URL=http://127.0.0.1:8001
# SOURCE_RETRY_ATTEMPTS=3
# SOURCE_RETRY_BACKOFF_S=0.5
# SOURCE_TIMEOUT_S=5
# Fault injection for the simulator: none | always_500 | flaky | slow
# SIM_FAILURE_MODE=none

# Logging: LOG_FORMAT=json|text (Docker uses json), LOG_LEVEL=DEBUG|INFO|WARNING|ERROR
# LOG_FORMAT=text
# LOG_LEVEL=INFO
